# ============================================================
# AskBase 配置模板
#
# 用法：复制成 .env 再填你自己的 Key
#   Windows      copy .env.example .env
#   macOS/Linux  cp .env.example .env
#
# 什么都不填也能启动 —— 会进入 Mock 模式（从检索结果抽句子回答），
# 链路完全一样，适合先跑通再决定接哪家模型。
# ============================================================

# ---------- 方式 A：任意 OpenAI 兼容端点（推荐） ----------
# 填了这三项就优先使用，下面的 DEEPSEEK_* 会被忽略。
# 常见厂商的取值见 README「接入你自己的 API Key」。
#
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1    qwen-plus
#   Kimi       https://api.moonshot.cn/v1                            moonshot-v1-8k
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4                  glm-4-flash（免费）
#   硅基流动    https://api.siliconflow.cn/v1                         Qwen/Qwen2.5-7B-Instruct
#   OpenAI     https://api.openai.com/v1                             gpt-4o-mini
#   本地 Ollama http://localhost:11434/v1                            qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------- 方式 B：DeepSeek 专用（历史配置，仍然兼容） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# auto: 有 Key 用真实模型，没 Key 自动降级 Mock
LLM_PROVIDER=auto

# ---------- 跨厂商裁判（只在评测复核时用，可以不填） ----------
# 用来避免"自己评自己"，填了才会启用；不填则用主模型复核。
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# ---------- 检索参数（有默认值，一般不用改） ----------
TOP_K=5
RRF_K=60
BM25_WEIGHT=0.6
VECTOR_WEIGHT=0.2
BM25_MIN_RATIO=0.65
MIN_COS_RATIO=0.4
RERANK_PROVIDER=llm

# ---------- 切分参数 ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=60
